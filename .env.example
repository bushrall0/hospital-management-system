# Oracle Database Configuration
# Local Oracle XE example:
#   DB_CONNECTION_STRING=localhost/XEPDB1
# Oracle Autonomous Database (Always Free):
#   DB_CONNECTION_STRING=<dbname>_low        (service name from tnsnames.ora in the wallet)
#   DB_WALLET_DIR=C:/path/to/unzipped/wallet (on Render: /etc/secrets)
#   DB_WALLET_PASSWORD=<password chosen when downloading the wallet>
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECTION_STRING=localhost/XEPDB1
