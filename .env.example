# Oracle Database Configuration
# Local Oracle XE example:
#   DB_CONNECTION_STRING=localhost/XEPDB1
# Oracle Autonomous Database (Always Free): paste the TLS connection string from
# Database connection -> TLS, e.g. (description= (retry_count=20)...(service_name=xxx_low.adb.oraclecloud.com)...)
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CONNECTION_STRING=localhost/XEPDB1
